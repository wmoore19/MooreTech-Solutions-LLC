{
  "name": "QualificationRecord",
  "type": "object",
  "description": "Structured qualification of a contact against campaign criteria. Scoped to a client organization (tenant).",
  "properties": {
    "client_organization_id": {
      "type": "string",
      "description": "Client Organization id (tenant anchor)."
    },
    "contact_id": {
      "type": "string",
      "description": "Contact id."
    },
    "campaign_id": {
      "type": "string",
      "description": "Campaign id."
    },
    "qualification_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string",
      "description": "User id of staff who completed qualification."
    },
    "uses_service_currently": {
      "type": "boolean"
    },
    "current_provider": {
      "type": "string",
      "maxLength": 200
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "no_contract",
        "active",
        "upcoming_review",
        "expiring",
        "unknown"
      ],
      "default": "unknown"
    },
    "contract_review_date": {
      "type": "string",
      "format": "date"
    },
    "service_problem": {
      "type": "string",
      "maxLength": 2000
    },
    "facility_size": {
      "type": "string",
      "maxLength": 200
    },
    "number_of_locations": {
      "type": "string",
      "maxLength": 120
    },
    "expected_service_frequency": {
      "type": "string",
      "maxLength": 200
    },
    "decision_authority": {
      "type": "string",
      "enum": [
        "decision_maker",
        "influencer",
        "gatekeeper",
        "user",
        "unknown"
      ],
      "default": "unknown"
    },
    "approximate_opportunity_value": {
      "type": "string",
      "maxLength": 200
    },
    "stated_interest": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "agreed_next_step": {
      "type": "string",
      "maxLength": 1000
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "pending",
        "qualified",
        "disqualified",
        "override"
      ],
      "default": "pending"
    },
    "override_explanation": {
      "type": "string",
      "maxLength": 2000,
      "description": "Required when status is override."
    },
    "disqualification_reason": {
      "type": "string",
      "maxLength": 2000
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "permitted_staff_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "client_organization_id",
    "contact_id",
    "campaign_id",
    "qualification_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
