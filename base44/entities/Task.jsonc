{
  "name": "Task",
  "type": "object",
  "description": "A follow-up or reminder task. Can be assigned to MooreTech staff or a client user.",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization id this task belongs to (tenant anchor for client tasks)."
    },
    "campaign_id": {
      "type": "string",
      "description": "Campaign id, if applicable."
    },
    "assigned_user_id": {
      "type": "string",
      "description": "User id the task is assigned to."
    },
    "task_type": {
      "type": "string",
      "enum": [
        "follow_up",
        "research",
        "call",
        "email",
        "appointment_reminder",
        "approval",
        "report",
        "billing",
        "other"
      ],
      "default": "other"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "related_account_id": {
      "type": "string"
    },
    "related_contact_id": {
      "type": "string"
    },
    "related_appointment_id": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "assigned_user_id",
    "task_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mooretech_manager"
          }
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "client_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "client_viewer"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mooretech_manager"
          }
        },
        {
          "user_condition": {
            "role": "mooretech_staff"
          }
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mooretech_manager"
          }
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "client_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mooretech_manager"
          }
        }
      ]
    }
  }
}