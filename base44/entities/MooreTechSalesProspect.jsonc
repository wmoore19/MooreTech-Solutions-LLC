{
  "name": "MooreTechSalesProspect",
  "type": "object",
  "description": "A business that may hire MooreTech for lead-generation services. MooreTech-internal pipeline data — never visible to clients.",
  "properties": {
    "company": {
      "type": "string",
      "maxLength": 200
    },
    "owner_or_decision_maker": {
      "type": "string",
      "maxLength": 200
    },
    "industry": {
      "type": "string",
      "maxLength": 120
    },
    "city": {
      "type": "string",
      "maxLength": 120
    },
    "state": {
      "type": "string",
      "maxLength": 120
    },
    "website": {
      "type": "string",
      "maxLength": 500
    },
    "phone": {
      "type": "string",
      "maxLength": 50
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "lead_source": {
      "type": "string",
      "maxLength": 200
    },
    "current_sales_process": {
      "type": "string",
      "maxLength": 2000,
      "description": "How they currently find customers."
    },
    "capacity_for_new_business": {
      "type": "string",
      "maxLength": 500
    },
    "estimated_fit": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "default": "unknown"
    },
    "personalized_observation": {
      "type": "string",
      "maxLength": 3000,
      "description": "Why they may fit, written manually."
    },
    "sales_stage": {
      "type": "string",
      "enum": [
        "new",
        "researching",
        "contact_ready",
        "contact_attempted",
        "conversation",
        "free_sample_requested",
        "free_sample_delivered",
        "discovery_scheduled",
        "proposal_sent",
        "pilot_invoice_sent",
        "pilot_paid",
        "converted_to_client",
        "nurture",
        "not_interested",
        "do_not_contact"
      ],
      "default": "new"
    },
    "last_contact": {
      "type": "string",
      "format": "date-time"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "converted_organization_id": {
      "type": "string",
      "description": "Organization id created on conversion to client."
    },
    "sample_campaign_id": {
      "type": "string",
      "description": "Internal sample campaign id."
    },
    "free_sample_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "in_progress",
        "delivered"
      ],
      "default": "not_requested"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "call",
        "text"
      ],
      "default": "email"
    }
  },
  "required": [
    "company",
    "sales_stage"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
