{
  "name": "Campaign",
  "type": "object",
  "description": "A lead-generation campaign for a client. Scoped to a client organization (tenant).",
  "properties": {
    "client_organization_id": {
      "type": "string",
      "description": "Client Organization id (tenant anchor)."
    },
    "campaign_name": {
      "type": "string",
      "maxLength": 200
    },
    "service_promoted": {
      "type": "string",
      "maxLength": 500
    },
    "territory": {
      "type": "string",
      "maxLength": 500
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "campaign_status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_intake",
        "awaiting_payment",
        "researching",
        "awaiting_client_approval",
        "outreach_active",
        "paused",
        "reporting",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "account_target": {
      "type": "number",
      "description": "Target number of researched accounts.",
      "default": 50
    },
    "price": {
      "type": "number",
      "description": "Upfront pilot price.",
      "default": 300
    },
    "per_held_appointment_fee": {
      "type": "number",
      "description": "Fee per held qualified appointment.",
      "default": 150
    },
    "assigned_manager": {
      "type": "string",
      "description": "User id of assigned MooreTech campaign manager."
    },
    "assigned_researcher": {
      "type": "string",
      "description": "User id of assigned researcher."
    },
    "assigned_caller": {
      "type": "string",
      "description": "User id of assigned caller."
    },
    "qualification_criteria": {
      "type": "string",
      "maxLength": 5000
    },
    "client_approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "changes_requested"
      ],
      "default": "pending"
    },
    "campaign_notes": {
      "type": "string",
      "maxLength": 5000
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "sample",
        "founding_pilot",
        "service"
      ],
      "default": "founding_pilot"
    },
    "sales_prospect_id": {
      "type": "string",
      "description": "Source MooreTech sales prospect for samples and conversions."
    },
    "intake_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete"
      ],
      "default": "not_started"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "not_required",
        "awaiting_payment",
        "paid",
        "waived"
      ],
      "default": "awaiting_payment"
    },
    "permitted_staff_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MooreTech users explicitly assigned to this campaign."
    }
  },
  "required": [
    "client_organization_id",
    "campaign_name",
    "campaign_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
